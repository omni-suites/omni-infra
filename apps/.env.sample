# Copy to .env on the VM and align passwords with the URLs below

# Artifact Registry repo prefix (no trailing slash) — required for all app images
# Example: us-central1-docker.pkg.dev/my-project/my-repo
# Images: ${GCP_AR_REPO}/order-service|inventory-service|notification-service|omni-client:staging
GCP_AR_REPO=

# DB containers
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=order_db

MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=inventory_db

# App DATABASE_URL values (Docker DNS hostnames — NOT localhost)
ORDER_DATABASE_URL=postgresql://user:password@postgres-db:5432/order_db?schema=public
INVENTORY_DATABASE_URL=mysql://root:password@mysql-db:3306/inventory_db
NOTIFICATION_DATABASE_URL=mongodb://mongo-db:27017/notification_db

# Inter-service calls on the Docker network
INVENTORY_SERVICE_URL=http://inventory-service:3001
NOTIFICATION_SERVICE_URL=http://notification-service:3002

# Public hostnames are owned by infra/traefik/dynamic/routes.yml
# Injected into omni-client at runtime (keep in sync with Traefik routes)
VITE_API_ORDER_URL=https://order-svc.test-suites-poc.work.gd
VITE_API_INVENTORY_URL=https://inventory-svc.test-suites-poc.work.gd
VITE_API_NOTIFICATION_URL=https://notification-svc.test-suites-poc.work.gd
