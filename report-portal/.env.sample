# ReportPortal — copy to .env and change passwords before public exposure
# Used by: docker-compose.yml (values with ${VAR-default} fall back if unset)

# ---------------------------------------------------------------------------
# Postgres (service: postgres)
# ---------------------------------------------------------------------------
POSTGRES_USER=rpuser
POSTGRES_PASSWORD=change-me-rp-db
POSTGRES_DB=reportportal

# ---------------------------------------------------------------------------
# RabbitMQ (service: rabbitmq) — required; do not remove
# ---------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=rabbitmq
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq

# ---------------------------------------------------------------------------
# ReportPortal admin bootstrap (service: uat / authorization)
# Default in compose if unset: erebus
# ---------------------------------------------------------------------------
RP_INITIAL_ADMIN_PASSWORD=change-me-rp-admin

# ---------------------------------------------------------------------------
# Optional: override service images (leave commented to use compose defaults)
# ---------------------------------------------------------------------------
# MIGRATIONS_IMAGE=reportportal/migrations:5.15.4
# INDEX_IMAGE=reportportal/service-index:5.15.1
# UI_IMAGE=reportportal/service-ui:5.15.5
# API_IMAGE=reportportal/service-api:5.15.4
# UAT_IMAGE=reportportal/service-authorization:5.15.1
# JOBS_IMAGE=reportportal/service-jobs:5.15.2
# ANALYZER_IMAGE=reportportal/service-auto-analyzer:5.15.5

# ---------------------------------------------------------------------------
# Optional: S3 / MinIO datastore (default in compose is filesystem)
# Uncomment and set DATASTORE_TYPE only if you switch off filesystem storage
# ---------------------------------------------------------------------------
# STORAGE_ACCESSKEY=rpuser
# STORAGE_SECRETKEY=change-me-minio
# ANALYZER_STORAGE_PATH=./data/analyzer-storage

# Public hostname: see infra/traefik/dynamic/routes.yml (report-portal...)
